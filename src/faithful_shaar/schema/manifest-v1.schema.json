{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faithful-oversight.github.io/faithful-shaar/schema/manifest-v1.schema.json",
  "title": "shaar run manifest",
  "description": "Version 1 of the manifest shaar writes with every command. It lists each output file with its size and SHA-256, and each input, so a reader can confirm that a set of files is complete and unchanged. It is written last.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files",
    "generated_at",
    "inputs",
    "schema",
    "tool"
  ],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "size"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "generated_at": {
      "$ref": "#/$defs/time"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "sha256",
          "size"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "limits": {
      "description": "The size limits the run used, by name (see the --limit option). Present when the command reads files. A value above the built-in default was chosen by whoever ran the command.",
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "schema": {
      "const": "https://faithful-oversight.github.io/faithful-shaar/schema/manifest-v1.schema.json"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "shaar"
        },
        "version": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "RFC 3339, UTC, to the second, with a trailing Z."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
